# Every value below is optional — Aegis runs with none of them set.

# --- LLM ---
# auto => use local Ollama when the configured model is installed; otherwise heuristics.
# AEGIS_LLM_PROVIDER=auto   # auto | ollama | anthropic | heuristic
# ANTHROPIC_API_KEY=sk-ant-...
# AEGIS_LLM_MODEL=claude-sonnet-4-6

# --- Embeddings ---
# auto => try sentence-transformers, fall back to the built-in hashing encoder.
# Set to "local" to force the zero-dependency encoder (fastest cold start).
AEGIS_EMBEDDING_BACKEND=local

# --- Session store ---
# Unset => in-process TTL dict. docker compose sets this to the redis service.
# AEGIS_REDIS_URL=redis://redis:6379/0
AEGIS_SESSION_TTL_S=1800

# --- Ablation switches (architecture.md §7) ---
AEGIS_USE_SPARSE=true
AEGIS_USE_DENSE=true
AEGIS_USE_RERANKER=true
AEGIS_CONTROLLER_MODE=rule        # rule | always_wait

# --- Controller tuning ---
AEGIS_DRIFT_THRESHOLD=0.45
AEGIS_MIN_BUFFER_CHARS=28
AEGIS_PROVISIONAL_COOLDOWN_S=0.3

# --- Streaming realism ---
AEGIS_REALTIME_REPLAY=true
AEGIS_SIM_SPEED=1.0
# Models a network-attached index. Applied to Aegis AND the naive baseline
# equally, so it can never bias the comparison. 0 = pure local measurement.
AEGIS_RETRIEVAL_LATENCY_MS=0

# Local free/open-source LLM (recommended)
AEGIS_LLM_PROVIDER=auto
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_MODEL=qwen3:1.7b
