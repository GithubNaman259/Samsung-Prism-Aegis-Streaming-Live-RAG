:root{
  --bg:#000010;--bg-deep:#00000a;--blue:#078cff;--blue-2:#0077e8;--blue-glow:rgba(0,120,255,.45);
  --text:#f8f9fd;--secondary:#b8c0d0;--muted:#7e899e;--surface:rgba(20,50,110,.30);--surface-strong:rgba(18,55,125,.48);
  --border:rgba(255,255,255,.085);--green:#42e8a0;--amber:#ffc766;--red:#ff6b7a;--violet:#a996ff;
  --radius-sm:12px;--radius-md:18px;--radius-lg:24px;--pill:999px;--mono:ui-monospace,SFMono-Regular,Menlo,monospace;
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:
 radial-gradient(ellipse at 50% 105%,rgba(0,100,255,.68) 0%,rgba(0,55,155,.35) 30%,rgba(0,20,65,.14) 55%,transparent 78%),var(--bg);
 color:var(--text);font:15px/1.55 Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,16,.18),transparent 35%,rgba(0,0,10,.18));z-index:-2}
.ambient{position:fixed;pointer-events:none;filter:blur(80px);border-radius:50%;opacity:.22;z-index:-1}.ambient-a{width:340px;height:340px;right:-100px;top:18%;background:#087cff}.ambient-b{width:300px;height:300px;left:-120px;bottom:5%;background:#244cff}
button,input{font:inherit}button{cursor:pointer}.nav{height:72px;max-width:1240px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.055)}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--text)}.brand strong{display:block;font-size:17px;letter-spacing:-.2px}.brand small{display:block;color:var(--muted);font-size:9px;letter-spacing:1.5px;text-transform:uppercase;margin-top:1px}
.brand-mark{width:30px;height:30px;border:1px solid rgba(115,180,255,.35);border-radius:9px;display:grid;place-items:center;transform:rotate(45deg);background:linear-gradient(145deg,rgba(8,140,255,.55),rgba(25,40,120,.18));box-shadow:0 0 24px rgba(0,120,255,.2)}.brand-mark span{width:11px;height:11px;border:1px solid #8ecbff;background:rgba(8,140,255,.35);box-shadow:inset 0 0 9px #078cff}.nav-center{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:10px;letter-spacing:1.5px}.trust-dot{width:5px;height:5px;border-radius:50%;background:var(--blue);box-shadow:0 0 9px var(--blue)}
.system-pill{height:34px;padding:0 12px;border:1px solid var(--border);border-radius:var(--pill);background:rgba(15,24,54,.48);backdrop-filter:blur(12px);display:flex;align-items:center;gap:8px;color:var(--muted);font-size:10px}.dot{width:6px;height:6px;border-radius:50%;background:#7e899e}.dot.ok{background:var(--green);box-shadow:0 0 9px var(--green)}.dot.bad{background:var(--red);box-shadow:0 0 9px var(--red)}
.shell{max-width:1180px;margin:0 auto;padding:0 24px 50px}.hero{text-align:center;padding:78px 20px 42px}.eyebrow{display:flex;justify-content:center;align-items:center;gap:12px;color:#6f9ed4;font-size:9px;letter-spacing:2.2px;font-weight:700}.eyebrow-line{width:52px;height:1px;background:linear-gradient(90deg,transparent,#277cc8)}.eyebrow-line:last-child{background:linear-gradient(90deg,#277cc8,transparent)}.hero h1{font-size:clamp(46px,7vw,78px);line-height:.98;letter-spacing:-4px;margin:22px auto 22px;font-weight:750}.hero h1 span{background:linear-gradient(180deg,#fff 15%,#a9cfff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}.hero-copy{max-width:620px;margin:auto;color:var(--secondary);font-size:15px;line-height:1.7}
.glass-card{background:linear-gradient(180deg,rgba(25,55,120,.27),rgba(10,30,75,.39));border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:0 20px 50px rgba(0,0,0,.2);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}.composer{padding:18px;margin-bottom:18px}.composer-topline{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.input-label{font-size:10px;letter-spacing:1.6px;color:#9cb9dd;text-transform:uppercase;font-weight:700}.live-state{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:6px}.live-state i{width:5px;height:5px;border-radius:50%;background:var(--muted)}.live-state.active{color:#9bdcff}.live-state.active i{background:var(--blue);box-shadow:0 0 10px var(--blue);animation:pulse 1.2s infinite}
.composer-row{display:flex;gap:10px}.input-wrap{position:relative;flex:1}.input-glow{position:absolute;inset:-1px;border-radius:15px;background:linear-gradient(90deg,transparent,rgba(7,140,255,.24),transparent);opacity:0;transition:.25s;pointer-events:none}.input-wrap:focus-within .input-glow{opacity:1}.input-wrap input{width:100%;height:54px;padding:0 54px 0 17px;background:rgba(1,7,24,.56);border:1px solid rgba(255,255,255,.08);border-radius:15px;color:var(--text);outline:none;font-size:14px;transition:.2s}.input-wrap input:focus{border-color:rgba(7,140,255,.55);box-shadow:0 0 0 3px rgba(7,140,255,.08)}.input-wrap input::placeholder{color:#67758e}.send-button{height:54px;padding:0 20px;border:0;border-radius:15px;background:linear-gradient(135deg,#078cff,#006fd7);color:#fff;font-weight:700;box-shadow:0 10px 28px rgba(0,112,220,.25);display:flex;gap:12px;align-items:center;transition:.2s}.send-button:hover{transform:translateY(-1px);filter:brightness(1.08)}.send-arrow{font-size:18px}.icon-button{position:absolute;right:7px;top:7px;width:40px;height:40px;border-radius:11px;border:1px solid transparent;background:rgba(255,255,255,.035);color:#8fb5dc;display:grid;place-items:center}.icon-button:hover{border-color:rgba(7,140,255,.4);background:rgba(7,140,255,.1)}.mic-icon{font-size:11px;width:12px;height:15px;border:2px solid currentColor;border-radius:7px;color:currentColor;line-height:8px;text-indent:-999px;position:relative}.mic-icon:after{content:"";position:absolute;left:3px;bottom:-6px;width:4px;height:5px;border-left:2px solid currentColor;border-bottom:2px solid currentColor;border-radius:0 0 0 5px}.wave{position:absolute;width:2px;border-radius:2px;background:#078cff;opacity:0}.icon-button.live{background:rgba(255,80,105,.12);border-color:rgba(255,100,120,.3);color:#ff8090}.icon-button.live .wave{opacity:1;animation:wave 1s ease-in-out infinite}.wave-a{height:8px;right:5px}.wave-b{height:14px;right:1px;animation-delay:.14s!important}.wave-c{height:10px;right:-3px;animation-delay:.28s!important}.composer-meta{display:flex;align-items:center;gap:9px;color:#687891;font-size:10px;margin-top:9px}.composer-meta kbd{font:9px var(--mono);border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);border-radius:5px;padding:2px 5px;color:#9aa8bd}.meta-separator{width:3px;height:3px;border-radius:50%;background:#53647e}
.section-head{display:flex;align-items:center;justify-content:space-between}.section-head.compact{margin-bottom:12px}.section-kicker{font-size:9px;letter-spacing:1.8px;color:#5d8ec6;font-weight:750}.section-head h2{font-size:18px;letter-spacing:-.4px;margin:2px 0 0}.stream-clock{font:12px var(--mono);color:#8ec8ff;padding:6px 9px;border:1px solid rgba(7,140,255,.22);border-radius:9px;background:rgba(7,140,255,.06)}
.activity{padding:20px;margin-bottom:18px}.activity-stage{margin-top:16px;min-height:84px;padding:16px 18px;border-radius:17px;border:1px solid rgba(255,255,255,.065);background:rgba(0,8,28,.38);display:flex;align-items:center;gap:15px;position:relative;overflow:hidden}.activity-stage:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(7,140,255,.04),transparent);transform:translateX(-100%)}.activity-stage.active:after{animation:sweep 2.2s linear infinite}.stage-orb{width:42px;height:42px;flex:none;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle,#0b9bff 0 8%,rgba(7,140,255,.22) 25%,rgba(7,140,255,.03) 66%,transparent 68%);box-shadow:0 0 30px rgba(7,140,255,.22)}.stage-orb span{width:8px;height:8px;border-radius:50%;background:#d7f1ff;box-shadow:0 0 12px #078cff}.activity-stage.active .stage-orb{animation:orb 1.7s ease-in-out infinite}.stage-copy{flex:1;min-width:0}.stage-copy strong{display:block;font-size:13px}.stage-copy span{display:block;color:var(--muted);font-size:11px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stage-badge{font:9px var(--mono);letter-spacing:1.2px;color:#6f7f98;border:1px solid rgba(255,255,255,.07);padding:6px 8px;border-radius:8px}.stage-badge.active{color:#9dd7ff;border-color:rgba(7,140,255,.3);background:rgba(7,140,255,.06)}
.activity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.activity-item{min-height:76px;padding:12px;border:1px solid rgba(255,255,255,.055);border-radius:14px;background:rgba(0,8,28,.28);display:grid;grid-template-columns:30px 1fr;grid-template-rows:auto auto;column-gap:10px;transition:.2s}.activity-item.live{border-color:rgba(7,140,255,.3);background:rgba(7,140,255,.055);box-shadow:0 0 22px rgba(7,140,255,.05)}.activity-icon{grid-row:1/3;width:30px;height:30px;border-radius:9px;background:rgba(255,255,255,.035);display:grid;place-items:center}.activity-icon span{width:7px;height:7px;border-radius:50%;background:#586a86}.speculate-icon span{background:var(--amber);box-shadow:0 0 10px var(--amber)}.retrieve-icon span{background:var(--green);box-shadow:0 0 10px var(--green)}.token-icon span{background:var(--blue);box-shadow:0 0 10px var(--blue)}.activity-copy span{font-size:9px;letter-spacing:.7px;text-transform:uppercase;color:var(--muted)}.activity-copy strong{font:13px var(--mono);color:#dce9fa;margin-left:5px}.activity-item small{grid-column:2;color:#687891;font-size:9px;margin-top:1px}.timeline-wrap{margin-top:18px}.timeline-label,.mini-head{display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:1.5px;color:#6683a7;text-transform:uppercase;margin-bottom:8px}.timeline-label span:last-child,.mini-head span:last-child{font:9px var(--mono);letter-spacing:0;color:#586b86}.timeline{min-height:46px;padding:9px 8px;border-radius:12px;background:rgba(0,8,28,.38);display:flex;align-items:center;gap:0;overflow-x:auto}.timeline:empty:after{content:"No reasoning events yet";color:#4f6079;font-size:10px;margin:auto}.tick{min-width:104px;position:relative;display:flex;align-items:center;gap:7px;padding:5px 9px}.tick:not(:last-child):after{content:"";position:absolute;right:-1px;top:50%;width:18px;height:1px;background:rgba(255,255,255,.08)}.pip{width:7px;height:7px;border-radius:50%;background:#596b85;flex:none}.tick.prov .pip{background:var(--amber);box-shadow:0 0 9px var(--amber)}.tick.retr .pip{background:var(--green);box-shadow:0 0 9px var(--green)}.tick.supp .pip{background:var(--violet);box-shadow:0 0 9px var(--violet)}.tick .t{font:9px var(--mono);color:#70819b}.tick .d{font-size:9px;color:#a5b4c9}.query-area{margin-top:14px}.chips{display:flex;gap:7px;flex-wrap:wrap;min-height:26px}.sq{background:rgba(7,140,255,.08);border:1px solid rgba(7,140,255,.22);color:#a9d4ff;border-radius:var(--pill);padding:5px 10px;font-size:10px;animation:pop .28s ease}.sq.spec{background:rgba(255,199,102,.08);border-color:rgba(255,199,102,.24);color:#ffd994}
.results-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.85fr);gap:18px}.result-column,.side-column{min-width:0}.result-head{padding:0 2px 11px}.version{font:10px var(--mono);color:#9db0c9;padding:5px 8px;border:1px solid rgba(255,255,255,.08);border-radius:9px;background:rgba(255,255,255,.025)}.answer-card{padding:18px;min-height:240px}.answer{font-size:15px;line-height:1.75}.answer-empty{min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#63728a;text-align:center}.empty-orb{width:46px;height:46px;border-radius:50%;margin-bottom:12px;background:radial-gradient(circle,rgba(7,140,255,.45),rgba(7,140,255,.06) 45%,transparent 70%);box-shadow:0 0 30px rgba(7,140,255,.12)}.answer-empty p{margin:0;font-size:12px}.claim{margin:0 0 13px;padding:11px 13px;border-left:2px solid rgba(7,140,255,.5);border-radius:0 12px 12px 0;background:rgba(7,140,255,.035);animation:claimIn .35s ease}.claim.added{border-left-color:var(--green)}.claim.modified{border-left-color:var(--amber)}.claim.uncertain{border-left-color:var(--red)}.ring{display:inline-block;width:7px;height:7px;border-radius:50%;margin:0 6px 1px 0}.cite{display:inline-block;font:9px var(--mono);color:#9bcaff;background:rgba(7,140,255,.08);border:1px solid rgba(7,140,255,.22);border-radius:8px;padding:1px 6px;margin-left:6px;cursor:pointer}.cite:hover{background:var(--blue);color:#fff}.status-tag{font:9px var(--mono);color:#7788a0;margin-left:5px}.uncertainty{margin-top:12px;background:rgba(255,107,122,.07);border:1px solid rgba(255,107,122,.16);padding:11px 13px;border-radius:12px;font-size:11px;color:#d5aeb4}.uncertainty b{display:block;color:#ff8b98;font-size:9px;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px}.hidden{display:none}.evidence-card{margin-top:18px;padding:18px}.hint{font-size:10px;color:#61718a}.inspector{min-height:78px;border-radius:13px;background:rgba(0,8,28,.38);padding:12px}.inspector .cid{font:9px var(--mono);color:#6faeff;margin-bottom:6px}.inspector .ctext{font-size:11px;line-height:1.7;color:#b6c2d4}.placeholder{color:#586981;font-size:11px;margin:0;font-style:italic}
.metrics-card,.demo-card{padding:18px}.demo-card{margin-top:18px}.scoreboard{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.metric{padding:13px 8px;text-align:center;border:1px solid rgba(255,255,255,.06);background:rgba(0,8,28,.32);border-radius:13px}.mv{display:block;font:15px var(--mono);font-weight:650;color:#a8d5ff}.ml{display:block;color:#66768e;font-size:8px;letter-spacing:1px;text-transform:uppercase;margin-top:4px}.decision-list{margin-top:13px;max-height:150px;overflow:auto}.dec{display:grid;grid-template-columns:40px 72px 1fr;gap:6px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:9px}.dec .dt{font:9px var(--mono);color:#586a83}.dec .dd{font-weight:700}.dd.provisional_retrieve{color:var(--amber)}.dd.retrieve{color:var(--green)}.dr{color:#70809a;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.demo-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.demo-button{min-height:70px;text-align:left;border:1px solid rgba(255,255,255,.06);background:rgba(0,8,28,.3);border-radius:13px;padding:9px 10px;transition:.2s}.demo-button:hover{transform:translateY(-1px);border-color:rgba(7,140,255,.3);background:rgba(7,140,255,.05)}.demo-button span{display:block;color:#4f739e;font:8px var(--mono);margin-bottom:5px}.demo-button b{display:block;font-size:10px;color:#dce8f8}.demo-button small{display:block;color:#5f7089;font-size:8px;margin-top:2px}.reset-button{width:100%;margin-top:8px;height:34px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.025);border-radius:10px;color:#73839a;font-size:9px;letter-spacing:.5px}.reset-button:hover{border-color:rgba(255,255,255,.15);color:#b9c6d8}.footer{max-width:1180px;margin:0 auto;padding:8px 24px 26px;color:#43536b;font-size:9px;display:flex;gap:8px;justify-content:center;letter-spacing:.8px}
.processing .answer-card{border-color:rgba(7,140,255,.2)}.processing .answer{position:relative}.processing .answer:after{content:"";position:absolute;left:18px;right:18px;bottom:14px;height:2px;border-radius:2px;background:linear-gradient(90deg,transparent,#078cff,transparent);animation:loading 1.2s ease-in-out infinite}.listening .composer{box-shadow:0 0 0 1px rgba(7,140,255,.15),0 18px 55px rgba(7,140,255,.12)}
@keyframes pulse{50%{opacity:.45;transform:scale(.72)}}@keyframes wave{0%,100%{transform:scaleY(.45)}50%{transform:scaleY(1.25)}}@keyframes orb{50%{transform:scale(1.08);filter:brightness(1.25)}}@keyframes sweep{to{transform:translateX(100%)}}@keyframes pop{from{opacity:0;transform:translateY(4px) scale(.96)}to{opacity:1;transform:none}}@keyframes claimIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}@keyframes loading{0%{transform:translateX(-20%);opacity:.15}50%{opacity:1}100%{transform:translateX(20%);opacity:.15}}
@media(max-width:900px){.nav-center{display:none}.hero{padding-top:58px}.results-grid{grid-template-columns:1fr}.activity-grid{grid-template-columns:1fr}.side-column{display:grid;grid-template-columns:1fr 1fr;gap:14px}.demo-card{margin-top:0}.decision-list{max-height:120px}}
@media(max-width:620px){.nav{padding:0 16px}.system-pill{max-width:120px;overflow:hidden;white-space:nowrap}.shell{padding:0 14px 40px}.hero{padding:50px 8px 30px}.hero h1{font-size:45px;letter-spacing:-2.5px}.composer-row{flex-direction:column}.send-button{width:100%;justify-content:center}.side-column{display:block}.demo-card{margin-top:14px}.activity-grid{grid-template-columns:1fr}.composer-meta{flex-wrap:wrap}.nav{height:64px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition:none!important}}
